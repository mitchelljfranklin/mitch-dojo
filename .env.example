# Deployment bootstrap (infra only — operational settings are managed in-app
# under Settings, and secrets saved there are encrypted at rest with
# APP_ENCRYPTION_KEY).

# Database mode: postgres (server mode) | pglite (embedded, single container)
DATABASE_PROVIDER=postgres

# Postgres mode: full connection string
DATABASE_URL=postgresql://mitch:mitch@localhost:5432/mitch_dojo?schema=public

# Compose database credentials (the container's DATABASE_URL is derived
# from these). Defaults shown; change for production.
# POSTGRES_USER=mitch
# POSTGRES_PASSWORD=mitch
# POSTGRES_DB=mitch_dojo
# DB_PORT=5432

# Lite mode: filesystem directory for the embedded PGlite database
# DATABASE_DIR=./.data/pglite

# Auth.js session signing secret — generate with: openssl rand -hex 32
AUTH_SECRET=

# Encrypts secrets stored in Settings (SMTP password, storage keys)
# — generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# Public base URL of the app (drives links and future SSO callbacks)
APP_URL=http://localhost:3000

# Required in production — protects /api/cron/run — generate with: openssl rand -hex 32
CRON_SECRET=

# File storage root (brand logo, attachments)
DATA_STORAGE_PATH=./.storage/files

# Number of trusted reverse proxies in front of the app (0 = direct)
TRUSTED_PROXY_COUNT=0
