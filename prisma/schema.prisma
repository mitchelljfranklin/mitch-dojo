generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs            AuditLog[]
  passwordResetTokens  PasswordResetToken[]
  sentNotificationLogs NotificationLog[]    @relation("NotificationSentBy")
  trainerProfile       Trainer?
  markedAttendance     Attendance[]         @relation("AttendanceMarkedBy")
  awardedBelts         StudentBelt[]        @relation("BeltAwardedBy")

  @@index([roleId])
  @@map("users")
}

model AppSetting {
  id        String   @id @default(cuid())
  category  String
  key       String   @unique
  value     Json
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("app_settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model NotificationLog {
  id           String   @id @default(cuid())
  assessmentId String?
  type         String
  sentTo       String
  subject      String?
  status       String
  errorMessage String?
  sentAt       DateTime @default(now())
  sentById     String?
  sentBy       User?    @relation("NotificationSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([assessmentId])
  @@index([sentAt])
  @@index([status])
  @@map("notification_logs")
}

enum StudentStatus {
  TRIAL
  ACTIVE
  INACTIVE
  ALUMNI
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  EXCUSED
  ABSENT
}

model Location {
  id           String   @id @default(cuid())
  name         String   @unique
  address      String?
  phone        String?
  email        String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  checkinToken String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentLocations StudentLocation[]
  courses          Course[]
  sessions         ClassSession[]

  @@map("locations")
}

model Student {
  id                    String        @id @default(cuid())
  firstName             String
  lastName              String
  email                 String?       @unique
  phone                 String?
  dateOfBirth           DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  guardianName          String?
  guardianEmail         String?
  guardianPhone         String?
  status                StudentStatus @default(TRIAL)
  notes                 String?
  photoKey              String?
  joinedAt              DateTime      @default(now())
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  locations  StudentLocation[]
  attendance Attendance[]
  belts      StudentBelt[]

  @@index([lastName, firstName])
  @@index([status])
  @@map("students")
}

model StudentLocation {
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  isPrimary  Boolean  @default(false)
  joinedAt   DateTime @default(now())

  @@id([studentId, locationId])
  @@index([locationId])
  @@map("student_locations")
}

model Attachment {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  fileName    String
  storageKey  String
  mimeType    String
  sizeBytes   Int
  displayName String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@map("attachments")
}

model Trainer {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  bio       String?
  isActive  Boolean  @default(true)
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]

  @@map("trainers")
}

model Course {
  id          String   @id @default(cuid())
  name        String
  description String?
  locationId  String
  location    Location @relation(fields: [locationId], references: [id])
  trainerId   String?
  trainer     Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trainingTimes TrainingTime[]
  sessions      ClassSession[]
  beltLevels    BeltLevel[]

  @@index([locationId])
  @@index([trainerId])
  @@map("courses")
}

// Belt rank within one course. order 0 is the entry rank; requiredTrainings
// is the CUMULATIVE total of trained sessions (Present/Late) on the course a
// student needs to be awarded THIS belt — 0 for the entry belt.
model BeltLevel {
  id                String   @id @default(cuid())
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name              String
  colorHex          String
  order             Int
  requiredTrainings Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  studentBelts StudentBelt[]

  @@unique([courseId, name])
  @@index([courseId, order])
  @@map("belt_levels")
}

// One row per awarded rank — the immutable promotion history. Belt name and
// colour are denormalised so history stays readable if belt levels are later
// reorganised (beltLevelId keeps the link when it still exists).
model StudentBelt {
  id          String     @id @default(cuid())
  studentId   String
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  beltLevelId String?
  beltLevel   BeltLevel? @relation(fields: [beltLevelId], references: [id], onDelete: SetNull)
  beltName    String
  colorHex    String
  awardedAt   DateTime
  notes       String?
  awardedById String?
  awardedBy   User?      @relation("BeltAwardedBy", fields: [awardedById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([studentId])
  @@index([beltLevelId])
  @@map("student_belts")
}

// The school's standard belt ladder, maintained in Settings → Belts. Courses
// can load it as a starting point and customise from there.
model BeltRangeEntry {
  id                String   @id @default(cuid())
  name              String   @unique
  colorHex          String
  order             Int
  requiredTrainings Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([order])
  @@map("belt_range_entries")
}

// Recurring weekly slot for a course. Weekday follows JS getDay convention
// (0 = Sunday … 6 = Saturday); times are wall-clock "HH:MM" strings so the
// dojo's local timetable stays unambiguous across DST boundaries.
model TrainingTime {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, weekday, startTime])
  @@map("training_times")
}

// Concrete occurrence generated from a course's training times.
// locationId is denormalised at generation time so attendance history stays
// stable even if the course later moves to a different location.
model ClassSession {
  id          String        @id @default(cuid())
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  locationId  String
  location    Location      @relation(fields: [locationId], references: [id])
  date        DateTime
  startTime   String
  endTime     String
  status      SessionStatus @default(SCHEDULED)
  cancelledAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  attendance Attendance[]

  @@unique([courseId, date, startTime])
  @@index([date])
  @@index([status])
  @@map("class_sessions")
}

model Attendance {
  id         String           @id @default(cuid())
  sessionId  String
  session    ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     AttendanceStatus @default(PRESENT)
  source     String           @default("MANUAL")
  markedById String?
  markedBy   User?            @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  markedAt   DateTime         @default(now())

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@index([markedAt])
  @@map("attendance")
}
