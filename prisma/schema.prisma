generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs            AuditLog[]
  passwordResetTokens  PasswordResetToken[]
  sentNotificationLogs NotificationLog[]    @relation("NotificationSentBy")
  trainerProfile       Trainer?
  markedAttendance     Attendance[]         @relation("AttendanceMarkedBy")
  awardedBelts         StudentBelt[]        @relation("BeltAwardedBy")
  createdInvoices      Invoice[]            @relation("InvoiceCreatedBy")
  recordedPayments     Payment[]            @relation("PaymentRecordedBy")
  ssoIdentities        SsoIdentity[]

  @@index([roleId])
  @@map("users")
}

// One row per external identity linked to a local user. A user may hold
// several (e.g. Entra ID + Google); the (provider, providerId) pair is the
// IdP's stable subject and never changes.
model SsoIdentity {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  providerId String
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@index([userId])
  @@map("sso_identities")
}

model AppSetting {
  id        String   @id @default(cuid())
  category  String
  key       String   @unique
  value     Json
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("app_settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Member portal access (Phase 10): staff email a magic link containing a
// one-time raw token; the hash is stored here and exchanged for a cookie on
// first visit. Regenerating a link does not revoke previously issued ones
// that are still unexpired.
model PortalToken {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([expiresAt])
  @@map("portal_tokens")
}

model NotificationLog {
  id           String   @id @default(cuid())
  assessmentId String?
  type         String
  sentTo       String
  subject      String?
  status       String
  errorMessage String?
  sentAt       DateTime @default(now())
  sentById     String?
  sentBy       User?    @relation("NotificationSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([assessmentId])
  @@index([sentAt])
  @@index([status])
  @@map("notification_logs")
}

enum StudentStatus {
  TRIAL
  ACTIVE
  INACTIVE
  ALUMNI
}

// Pipeline stage for TRIAL students (Phase 9). CONVERTED/LOST close the
// pipeline; CONVERTED students carry convertedAt and flip to ACTIVE.
enum TrialStage {
  NEW
  CONTACTED
  FIRST_CLASS
  CONVERTED
  LOST
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  EXCUSED
  ABSENT
}

enum PlanType {
  RECURRING
  ITEM
}

enum BillingPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum EnrollmentStatus {
  ACTIVE
  ENDED
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD_TERMINAL
  OTHER
}

model Location {
  id           String   @id @default(cuid())
  name         String   @unique
  address      String?
  phone        String?
  email        String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  checkinToken String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentLocations StudentLocation[]
  courses          Course[]
  sessions         ClassSession[]
  invoices         Invoice[]

  @@map("locations")
}

model Student {
  id                    String        @id @default(cuid())
  firstName             String
  lastName              String
  email                 String?       @unique
  phone                 String?
  dateOfBirth           DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  guardianName          String?
  guardianEmail         String?
  guardianPhone         String?
  // Free-text relationship of the guardian to the student (Mother, Father,
  // Grandparent, …) — captured for pickups, emergency context, and mail
  // merge. Only meaningful when a guardian is recorded.
  guardianRelationship  String?
  status                StudentStatus @default(TRIAL)
  // Trial pipeline (Phase 9): stage is non-null only while the student is a
  // managed trial lead; convertedAt records when they became a member.
  trialStage            TrialStage?
  convertedAt           DateTime?
  // Postal address (optional, Phase 11 follow-up) — structured for CSV
  // round-trips and labels. state is a catch-all (state/region/province);
  // country is an ISO 3166-1 alpha-2 code.
  addressLine           String?
  city                  String?
  state                 String?
  postcode              String?
  country               String?
  notes                 String?
  photoKey              String?
  joinedAt              DateTime      @default(now())
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  locations   StudentLocation[]
  disciplines StudentDiscipline[]
  attendance  Attendance[]
  belts       StudentBelt[]
  enrollments Enrollment[]
  invoices    Invoice[]
  portalTokens PortalToken[]

  @@index([lastName, firstName])
  @@index([status])
  @@map("students")
}

// Which disciplines a student trains. One or more per student (a school may
// teach Karate and Jujitsu); drives which progression tables the student
// appears in. Rank itself is per discipline (StudentBelt).
model StudentDiscipline {
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  disciplineId String
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@id([studentId, disciplineId])
  @@index([disciplineId])
  @@map("student_disciplines")
}

model StudentLocation {
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  isPrimary  Boolean  @default(false)
  joinedAt   DateTime @default(now())

  @@id([studentId, locationId])
  @@index([locationId])
  @@map("student_locations")
}

model Attachment {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  fileName    String
  storageKey  String
  mimeType    String
  sizeBytes   Int
  displayName String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@map("attachments")
}

model Trainer {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  bio       String?
  isActive  Boolean  @default(true)
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]

  @@map("trainers")
}

model Course {
  id           String     @id @default(cuid())
  name         String
  description  String?
  locationId   String
  location     Location   @relation(fields: [locationId], references: [id])
  disciplineId String
  discipline   Discipline @relation(fields: [disciplineId], references: [id])
  trainerId    String?
  trainer      Trainer?   @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  trainingTimes TrainingTime[]
  sessions      ClassSession[]

  @@index([locationId])
  @@index([disciplineId])
  @@index([trainerId])
  @@map("courses")
}

model Discipline {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beltRangeEntries BeltRangeEntry[]
  courses          Course[]
  students         StudentDiscipline[]

  @@map("disciplines")
}

// Belt rank within a discipline's ladder. order 0 is the entry rank;
// requiredTrainings is the CUMULATIVE total of trained sessions (Present/Late)
// across ALL courses of that discipline a student needs to be awarded THIS
// belt — 0 for the entry belt.
model BeltRangeEntry {
  id                String     @id @default(cuid())
  disciplineId      String
  discipline        Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  name              String
  colorHex          String
  order             Int
  requiredTrainings Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  studentBelts StudentBelt[]

  @@unique([disciplineId, name])
  @@index([disciplineId, order])
  @@map("belt_range_entries")
}

// One row per awarded rank — the immutable promotion history. Belt name and
// colour are denormalised so history stays readable if the ladder is later
// reorganised (beltRangeEntryId keeps the link when it still exists). The
// rank is per discipline, global across all locations teaching it.
model StudentBelt {
  id               String          @id @default(cuid())
  studentId        String
  student          Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  beltRangeEntryId String?
  beltRangeEntry   BeltRangeEntry? @relation(fields: [beltRangeEntryId], references: [id], onDelete: SetNull)
  beltName         String
  colorHex         String
  awardedAt        DateTime
  notes            String?
  awardedById      String?
  awardedBy        User?           @relation("BeltAwardedBy", fields: [awardedById], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@index([studentId])
  @@index([beltRangeEntryId])
  @@map("student_belts")
}

// Recurring weekly slot for a course. Weekday follows JS getDay convention
// (0 = Sunday … 6 = Saturday); times are wall-clock "HH:MM" strings so the
// dojo's local timetable stays unambiguous across DST boundaries.
model TrainingTime {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, weekday, startTime])
  @@map("training_times")
}

// Concrete occurrence generated from a course's training times.
// locationId is denormalised at generation time so attendance history stays
// stable even if the course later moves to a different location.
model ClassSession {
  id          String        @id @default(cuid())
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  locationId  String
  location    Location      @relation(fields: [locationId], references: [id])
  date        DateTime
  startTime   String
  endTime     String
  status      SessionStatus @default(SCHEDULED)
  cancelledAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  attendance Attendance[]

  @@unique([courseId, date, startTime])
  @@index([date])
  @@index([status])
  @@map("class_sessions")
}

model Attendance {
  id         String           @id @default(cuid())
  sessionId  String
  session    ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     AttendanceStatus @default(PRESENT)
  source     String           @default("MANUAL")
  markedById String?
  markedBy   User?            @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  markedAt   DateTime         @default(now())

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@index([markedAt])
  @@map("attendance")
}

// A billable plan. RECURRING plans generate invoices on a cycle (school-wide
// memberships — a student has one membership covering all their training);
// ITEM plans are one-off billables (grading fees, gear) invoiced manually.
// Money is stored as integer cents to avoid float rounding.
model MembershipPlan {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String?
  planType      PlanType       @default(RECURRING)
  billingPeriod BillingPeriod?
  priceCents    Int
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  enrollments Enrollment[]

  @@map("membership_plans")
}

// A student's subscription to a plan. RECURRING enrollments carry
// nextInvoiceDate — the scheduler generates an invoice when it passes.
// ITEM enrollments are billed manually (no cycle).
model Enrollment {
  id              String          @id @default(cuid())
  studentId       String
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  planId          String
  plan            MembershipPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  status          EnrollmentStatus @default(ACTIVE)
  startDate       DateTime
  endDate         DateTime?
  nextInvoiceDate DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  invoices Invoice[]

  @@index([studentId])
  @@index([planId])
  @@index([status, nextInvoiceDate])
  @@map("enrollments")
}

// Invoice number is a sequential integer assigned per school. Status PAID is
// derived in the data layer from the payment total; an OPEN invoice whose
// dueDate has passed is surfaced as overdue without changing the stored row.
model Invoice {
  id           String        @id @default(cuid())
  number       Int           @unique
  studentId    String
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollmentId String?
  enrollment   Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  // Optional: manually-billed invoices may name the dojo site they relate
  // to (grading fees, gear). Recurring memberships are school-wide and
  // leave this null, so those invoices only count towards "All locations".
  locationId   String?
  location     Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  status       InvoiceStatus @default(OPEN)
  issueDate    DateTime
  dueDate      DateTime
  notes        String?
  createdById  String?
  createdBy    User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([studentId])
  @@index([status, dueDate])
  @@index([locationId])
  @@map("invoices")
}

// Line items denormalise the plan name/price at invoice time so later plan
// edits never rewrite issued documents.
model InvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int     @default(1)
  unitPriceCents Int

  @@index([invoiceId])
  @@map("invoice_items")
}

// Manual payment records against an invoice (cash/transfer/terminal first —
// gateways are a later phase). An invoice becomes PAID when its payments
// cover the item total; partial payments are allowed.
model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountCents  Int
  method       PaymentMethod @default(CASH)
  paidAt       DateTime
  reference    String?
  recordedById String?
  recordedBy   User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())

  @@index([invoiceId])
  @@index([paidAt])
  @@map("payments")
}
